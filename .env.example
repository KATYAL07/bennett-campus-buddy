# Campus Buddy - Environment Variables Example
# In demo mode, none of these variables are required. The app runs completely in-memory!
# For production deployment with Supabase, populate these in your Vercel project settings.

# Public Supabase credentials (safe because Row Level Security is active on all tables)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key-placeholder"

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-service-role-key-placeholder"

# Production App URL (e.g., https://campus-buddy.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated list of admin emails who have moderation / admin dashboard access
ADMIN_EMAILS="arnav@bennett.edu.in,techhead@bennett.edu.in"

# Optional: enforce student email domain on sign-in (e.g. bennett.edu.in)
# Leave empty to allow any Google account
ALLOWED_EMAIL_DOMAIN="bennett.edu.in"
